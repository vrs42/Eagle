Edit M101.dev;
Prefix 'M101_';
Description '\
<qt><b>Bus Data Interface</b>\n\
<p>\n\
The M101 contains 15 two-input NAND gates.  One input of each gate is tied to a common line so that all data signals can be enabled simultaneously.  <p>Each data signal presents one TTL load.  The common input presents 15 loads. <p> Each output can drive 10 loads.<p>\n\
Power: 5V@82ma (max.)\n\
</qt>';
Value Off;
Add NAND1 'E1' Next 1 (-22.86 15.24);
Add NAND1 'H1' Next 1 (30.48 25.4);
Add NAND1 'K1' Next 1 (5.08 15.24);
Add NAND1 'M1' Next 1 (5.08 5.08);
Add NAND1 'P1' Next 1 (5.08 -5.08);
Add NAND1 'S1' Next 1 (5.08 -15.24);
Add NAND1 'U1' Next 1 (5.08 25.4);
Add NAND1 'F2' Next 1 (-22.86 5.08);
Add NAND1 'J2' Next 1 (-22.86 -5.08);
Add NAND1 'L2' Next 1 (-22.86 -15.24);
Add NAND1 'N2' Next 1 (30.48 15.24);
Add NAND1 'R2' Next 1 (30.48 5.08);
Add NAND1 'T2' Next 1 (30.48 -5.08);
Add NAND1 'V2' Next 1 (30.48 -15.24);
Add POWER 'G$16' Request 0 (25.4 35.56);
Add NAND2 'B1' Must 1 (-22.86 25.4);
Add T1GND 'G$1' Request 0 (33.02 35.56);
Package 'H807' '''''';
Technology  '';
Connect  'V2.IN' 'U2'  'V2.OUT' 'V2'  'U1.OUT' 'U1'  'U1.IN' 'V1'  'T2.OUT' 'T2' \
         'R2.OUT' 'R2'  'N2.OUT' 'N2'  'G$1.GND' 'T1'  'S1.OUT' 'S1'  'T2.IN' 'S2'  'S1.IN' 'R1' \
         'P1.OUT' 'P1'  'R2.IN' 'P2'  'P1.IN' 'N1'  'M1.OUT' 'M1'  'K1.OUT' 'K1'  'H1.OUT' 'H1' \
         'E1.OUT' 'E1'  'B1.IN2' 'C1'  'B1.IN1' 'A1'  'G$16.VCC' 'A2'  'G$16.GND' 'C2'  'F2.IN' 'E2' \
         'J2.IN' 'H2'  'L2.IN' 'K2'  'N2.IN' 'M2'  'L2.OUT' 'L2'  'J2.OUT' 'J2'  'F2.OUT' 'F2' \
         'B1.OUT' 'B1'  'E1.IN' 'D1'  'H1.IN' 'F1'  'K1.IN' 'J1'  'M1.IN' 'L1';

Edit M101-ARRAY.dev;
Prefix 'M101_';
Description 'M101 Bus Data Interface';
Value Off;
Add M101A 'G$1' Next 0 (-40.64 2.54);
Add POWER 'G$2' Request 0 (83.82 -2.54);
Add T1GND 'G$3' Request 0 (88.9 -2.54);
Package 'H807' '''''';
Technology  '';
Connect  'G$1.IN15' 'U2'  'G$1.O15' 'V2'  'G$1.O8' 'U1'  'G$1.IN8' 'V1'  'G$1.O14' 'T2' \
         'G$1.O13' 'R2'  'G$1.O12' 'N2'  'G$3.GND' 'T1'  'G$1.O7' 'S1'  'G$1.IN14' 'S2'  'G$1.IN7' 'R1' \
         'G$1.O6' 'P1'  'G$1.IN13' 'P2'  'G$1.IN6' 'N1'  'G$1.O5' 'M1'  'G$1.O4' 'K1'  'G$1.O3' 'H1' \
