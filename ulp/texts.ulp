//
// This ULP scans a schematic for components whose values 
// don't match the device type.
//
// Errors are displayed in a dialog box.  No box means no errors!
//
//  Written by vrs, 3/19/2016.
//

if (!schematic) {
  dlgMessageBox("<hr><b>ERROR: No schematic!</b><p>\nThis program can only work in the schematic editor.");
  exit(1);
}

string outstr = "";
string tmp;
int errors = 0;
schematic(SC) {
  SC.sheets(S) {
    S.texts(T) {
      if (T.layer == 91) {
        sprintf(tmp, "Text %s on sheet %d\n",
               T.value, S.number);
        outstr += tmp;
        errors++;
      }
    }
  }
}

if (errors) {
  dlgMessageBox(outstr);
  if (errors > 50) {
    output("ulp.txt", "wt") {
      printf("%s", outstr);
    }
  }
  exit(1);
}
exit(0);
