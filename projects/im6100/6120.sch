<sheet>
<plain>
<text x="-35.56" y="248.92" size="1.778" layer="91">Need FZ implementation.</text>
<text x="190.5" y="106.68" size="1.778" layer="91">C0 = DEVSEL\\ ? EMA0 : ~C0\\;</text>
<text x="190.5" y="109.22" size="1.778" layer="91">C1 = DEVSEL\\ ? EMA1 : ~C1\\;</text>
<text x="190.5" y="114.3" size="1.778" layer="91">LXPAR\\ = CPSEL\\  | ~LXMAR;</text>
<text x="190.5" y="116.84" size="1.778" layer="91">LXMAR\\ = MEMSEL\\  |  ~LXMAR;</text>
<text x="190.5" y="124.46" size="1.778" layer="91">CPREQ\\ = CPREQ*\\ &amp; STRT\\;</text>
<text x="190.5" y="119.38" size="1.778" layer="91">LXDAR\\ = DEVSEL\\ | ~LXMAR;</text>
<text x="190.5" y="111.76" size="1.778" layer="91">SKPX = DEVSEL\\? INTREQ\\ : SKIP\\;</text>
<text x="190.5" y="104.14" size="1.778" layer="91">WRITE\\ = OUT\\  | LXMAR;</text>
<text x="190.5" y="127" size="1.778" layer="91">IOCLR\\ = 1 (not implemented)</text>
<text x="190.5" y="121.92" size="1.778" layer="91">if ~RESET\\ then STRT\\=0 elsif ~CPSEL\\ then STRT\\ = 1;</text>
<text x="175.26" y="121.92" size="1.778" layer="91">STRT\\</text>
</plain>
