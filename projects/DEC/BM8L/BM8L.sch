<text x="261.62" y="55.88" size="1.778" layer="94">7</text>
<text x="271.78" y="71.12" size="1.778" layer="94">L2</text>
<text x="271.78" y="68.58" size="1.778" layer="94">L2</text>
<text x="271.78" y="66.04" size="1.778" layer="94">L2</text>
<text x="271.78" y="63.5" size="1.778" layer="94">J2</text>
