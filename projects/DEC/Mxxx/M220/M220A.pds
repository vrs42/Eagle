EQUATIONS
; There's only really room for the AOI-style gate in a 16V8.
a3 = ac3*bh2 + (/ac3)*bj2 + bn2*bf1 + bd2*bc1 + bn1*bf2 + bp2*bl1 + bm1*bl2;
