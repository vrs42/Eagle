;PALASM Design Description

;---------------------------------- Declaration Segment ------------
TITLE    M220C.PDS
PATTERN  A
REVISION 1.0
AUTHOR   Vincent Slyngstad
COMPANY  None
DATE     03/20/2013

CHIP   M220C   PAL16V8

;---------------------------------- PIN Declarations ---------------
PIN  1          clock                COMBINATORIAL             ; INPUT
PIN  2          d2                   COMBINATORIAL             ; INPUT
PIN  3          d3                   COMBINATORIAL             ; INPUT
PIN  4          a3                   COMBINATORIAL             ; INPUT
PIN  5          b3   	                COMBINATORIAL             ; INPUT
PIN  6          bj1                  COMBINATORIAL             ; INPUT
PIN  7          a2                   COMBINATORIAL             ; INPUT
PIN  8          b2                   COMBINATORIAL             ; INPUT

PIN  10         GND                                            ; INPUT
PIN  12         c3                   COMBINATORIAL             ; OUTPUT
PIN  13         af1                  COMBINATORIAL             ; OUTPUT
PIN  14         ae2                  COMBINATORIAL             ; OUTPUT
PIN  15         bk2                  COMBINATORIAL             ; OUTPUT
PIN  16         q2_                  COMBINATORIAL             ; OUTPUT
PIN  17         q3_                  COMBINATORIAL             ; OUTPUT
PIN  18         q2                   REGISTERED                ; OUTPUT
PIN  19         q3                   REGISTERED                ; OUTPUT
PIN  20         VCC                                            ; INPUT

EQUATIONS
af1 = a3 :+: b3 :+: bj1;
c3 = a3*b3 + a3*bj1 + b3*bj1;
ae2 = a2 :+: b2 :+: c3;
bk2 = a2*b2 + a2*c3 + b2*c3;

q3 := d3;
q3.clkf = clock;
q3_ = /q3;

q2 := d2;
q2.clkf = clock;
q2_ = /q2;
