/MI8-EH (TD8-E DECtape)
SDSS=6771	/ SKIP ON SINGLE LINE
SDSQ=6773	/ SKIP ON QUAD LINE
SDLC=6774	/ LOAD COMMAND REGISTER
SDRC=6776	/ READ MT REGISTER
SDRD=6777	/ READ DATA REGISTER
	FIELD	0
	*7300
START,	TAD COMMND	/ GET 2000
	JMS COMMND	/ EXECUTE 3312 COMMAND
	JMS COMMND	/ EXECUTE 1312 COMMAND
AGAIN,	SDSQ		/ WAIT FOR A WORD
	JMP .-1
	SDRD		/ GET DATA WORD
	DCA I LOADAT	/ STORE IT
	ISZ LOADAT	/ BUMP POINTER
	JMP AGAIN	/ NO SKIP, DO ANOTHER
	JMP I RUNAT	/ BRANCH TO LOADED CODE
COMMND,	2000		/ "START COMMAND" SUBROUTINE
	TAD START	/ ADD/GET 1312
	SDLC		/ SEND THE COMMAND
L07315,	SDSS		/ DONE?
	JMP .-1		/ WAIT FOR IT
	SDRC		/ GET MT REGISTER
	AND C77		/ CHECK ONLY MT BITS
D07321,	TAD N0022	/ EXPECT 022
	SZA CLA 	/ GOT IT?
	JMP L07315	/ NO, CHECK AGAIN
	ISZ D07321	/ HENCEFORTH EXPECT 031
	JMP I COMMND	/ RETURN TO CALLER
LOADAT,	7354		/ STORE POINTER
N0022,	-22		/ MTR1 AND MTR4 SET FIRST TIME
	-31		/ MTR1 MTR2, AND MTR5 SET THEREAFTER
C77,	0077		/ MTR BIT MASK
RUNAT,	7400		/ ADDRESS TO BRANCH TO
	7777
	7777
	7777
	7777
	7777
$
