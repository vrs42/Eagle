/MI8-EF (Edu Sys Low)
CAF=6007	/ CLEAR ALL FLAGS
DTLA=6766	/ LOAD REGISTER A
DTSF=6771	/ SKIP ON FLAGS
DMAR=6603	/ START READ
DFSC=6622	/ SKIP IF DONE
	FIELD	0
	*7737
START,	CAF			/ INITIALIZE
	LAS			/ READ THE SWITCHES
	SPA			/ BIT 0 SET?
	DCA .+1			/ YES, USE IT INSTEAD
L07743,	DTLA			/ MOVE DECTAPE
	DTSF			/ WAIT FOR IT
	JMP .-1
/ THE READ COMMAND WILL REPLACE THIS CODE
/ THE SECOND TIME THROUGH.
	TAD P07776		/ GET READ COMMAND
	JMP L07743		/ GO DO IT
/ DF32 BOOT
	7600			/ CLA, ALSO WORD COUNT!
	DMAR			/ START A READ, ALSO CA!
	DFSC			/ WAIT FOR IT
	JMP .-1
	JMP I .-2		/ JUMP INTO THE NEW CODE
	7577			/ UNUSED
/ THIS REST IS JUST THE HIGH SPEED RIM LOADER.
L07756,	RFC			/ FETCH FROM LSR
L07757,	RSF 			/ SKIP IF READY
	JMP .-1
D07761,	RRB RFC			/ GET HIGH 6 BITS
	CLL RTL 		/ SHIFT UP
	RTL 
	SPA 			/ CHECK FOR LEADER
	JMP L07774		/ IGNORE LEADER
	RTL 			/ FINISH SHIFT UP
L07767,	RSF 			/ WAIT FOR LOW 6 BITS
	JMP .-1
D07771,	RRB RFC			/ OR THEM IN
	SNL 			/ LOCATION OR DATA?
	DCA I P07776		/ DATA
L07774,	DCA P07776		/ LOCATION
	JMP L07757		/ GO LOOK FOR MORE
P07776,	220			/ SAVED LOCATION (OR 0)
$
