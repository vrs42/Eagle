/MI8-EJ (RK8-E)
CAF=6007	/ CLEAR ALL FLAGS
DLAG=6743	/ LOAD DISC ADDRESS & GO
DRST=6745	/ READ THE STATUS
*14
PTR,	MESG-1			/ POINTER TO TEXT (AUTOINDEX!)
START,	CAF			/ INITIALIZE
	TAD I PTR		/ GET A CHARACTER
	TLS			/ START IT PRINTING
	TSF			/ WAIT FOR IT
	JMP .-1
	CLA			/ CLEAR AC FOR NEXT
	ISZ COUNT		/ BUMP COUNTER
	JMP START+1		/ GO PRINT NEXT
	DRST			/ READ STATUS
	SZA			/ CLEAR?
	JMP .-2			/ NO, WAIT FOR IT
	DLAG			/ START AN I/O
	JMP .			/ WAIT FOR THIS TO BE REPLACED
COUNT,	-21			/ NUMBER OF CHARS TO PRINT
MESG,	0215			/ CR
	0212			/ LF
	0000			/ NUL
	0000			/ NUL
	0000			/ NUL
	"I
	"N
	"I
	"T
	"I
	"A
	"L
	"I
	"Z
	"I
	"N
	"G

START=0015
$
