/MI8-EM (Typeset DECtape)
DTLB=6774	/ LOAD REGISTER B
DTSF=6771	/ SKIP ON FLAGS
DTCA=6762	/ CLEAR REGISTER A
DTXA=6764	/ LOAD REGISTER A
	FIELD	0
	*7730
START,	DTLB		/ CLEAR EXISTING ERROR CONDITIONS
	TAD D07747	/ GET A MOVE UNIT 4 COMMAND
	JMS DTGO	/ DO IT
	CLA CMA 	/ GET LOADAT-1
	TAD LOADAT
	DCA CA		/ SET UP CA
	TAD D07752	/ GET READ UNIT 4 COMMAND
	JMS DTGO	/ DO IT -- WC WILL BE LOADED OVER
	JMP I LOADAT	/ BRANCH TO THE NEW CODE
DTGO,	.-.		/ DO A DECTAPE COMMAND
	DTCA DTXA	/ SEND COMMAND
	DCA WC		/ CLEAR WC
	DTSF		/ DONE?
	JMP .-1		/ WAIT FOR IT
	JMP I DTGO	/ RETURN TO CALLER
D07747,	4600		/ MOVE UNIT 4 COMMAND
	0000		/ UNUSED
	0000		/ UNUSED
D07752,	4220		/ READ UNIT 4 COMMAND
LOADAT,	7400		/ ADDRESS OF LOADED CODE
WC,	0000
CA,	0000
	0000		/ THESE ARE UNUSED
	0000		/ (LEFT THE DIODES IN)
