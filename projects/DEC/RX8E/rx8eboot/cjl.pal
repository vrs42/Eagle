/	TINY RX01 DRIVE ZERO ONLY BOOTSTRAP.

/ configuration section

IOTADR=0750             / default system drive is at IOT 75

/ RX01 and other opcode definitions

LCD=6001+IOTADR
XDR=6002+IOTADR
STR=6003+IOTADR
SDN=6005+IOTADR

NL0001=CLA CLL IAC
NL0002=CLA CLL CML RTL

/ Constants pertaining to the bootstrap sector being read.
SBOOT=0000
SLP=0047

	*33			/STARTS LOADING HERE

SHANGG,	SDN			/BOOTSTRAP STARTS HERE; DONE FLAG UP?
	JMP	SLODE1		/TRY TRANSFER FLAG IF DONE FLAG IS NOT UP
	NL0002			/SETUP FOR EMPTYING
	LCD			/LOAD THE COMMAND

	ZBLOCK	SLP-.		/0000'S WILL EXECUTE AND FALL THROUGH TO SLP!

SLP,	JMS	SLODE		/GET A WORD
SLPSTR,	DCA	SBOOT&177+2	/PUT A WORD
	ISZ	SLPSTR		/BUMP TO NEXT WORD
	JMP	SLP		/KEEP GOING UNTIL SLP IS OVERLAYED!

SLODE,	JMP	SLP		/LOAD A WORD ROUTINE;OK to use same as previous or following or anything else
SLODE1,	STR			/WORD READY?
	JMP	SHANGG		/NO, TRY DONE
	XDR			/YES, GET A WORD
	JMP I	SLODE		/RETURN

SBU,	0^20+7004		/INDICATE UNIT ZERO TO NEXT LEVEL
$
