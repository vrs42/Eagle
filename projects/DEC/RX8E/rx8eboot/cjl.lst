   1            /       TINY RX01 DRIVE ZERO ONLY BOOTSTRAP.
   2            
   3            / configuration section
   4            
   5            IOTADR=0750             / default system drive is at IOT 75
   6            
   7            DRIVE0=0000
   8            DRIVE1=0020
   9            DRIVE=DRIVE0            / set to either DRIVE0 or DRIVE1
  10            
  11            / RX01 and other opcode definitions
  12            
  13            LCD=6001+IOTADR
  14            XDR=6002+IOTADR
  15            STR=6003+IOTADR
  16            SDN=6005+IOTADR
  17            
  18            NL0001=CLA CLL IAC
  19            NL0002=CLA CLL CML RTL
  20            
  21            / Contstants pertaining to the bootstrap sector being read.
  22            SBOOT=0002
  23            SLP=0047
  24            
  25                    *33                     /STARTS LOADING HERE
  26            
  27 00033 6755 SHANGG, SDN                     /BOOTSTRAP STARTS HERE; DONE FLAG UP?
  28 00034 5054         JMP     SLODE1          /TRY TRANSFER FLAG IF DONE FLAG IS NOT UP
  29 00035 7326         NL0002                  /SETUP FOR EMPTYING
  30 00036 6751         LCD                     /LOAD THE COMMAND
  31            
  32 00037 0000         ZBLOCK  SLP-.           /0000'S WILL EXECUTE AND FALL THROUGH TO SLP!
     00040 0000 
     00041 0000 
     00042 0000 
     00043 0000 
     00044 0000 
     00045 0000 
     00046 0000 
  33            
  34 00047 4053 SLP,    JMS     SLODE           /GET A WORD
  35 00050 3004 SLPSTR, DCA     SBOOT&177+2     /PUT A WORD
  36 00051 2050         ISZ     SLPSTR          /BUMP TO NEXT WORD
  37 00052 5047         JMP     SLP             /KEEP GOING UNTIL SLP IS OVERLAYED!
  38            
  39 00053 5047 SLODE,  JMP     SLP             /LOAD A WORD ROUTINE;OK to use same as previous or following or anything else  40            
  41 00054 6753 SLODE1, STR                     /WORD READY?
  42 00055 5033         JMP     SHANGG          /NO, TRY DONE
  43 00056 6752         XDR                     /YES, GET A WORD
  44 00057 5453         JMP I   SLODE           /RETURN
  45            
  46 00060 7004 SBU,    DRIVE+7004              /INDICATE UNIT ZERO TO NEXT LEVEL
