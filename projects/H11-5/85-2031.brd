<param name="mdCopperDimension" value="13mil"/>
<param name="mdDrill" value="10mil"/>
<param name="mdSmdStop" value="0mil"/>
<param name="msWidth" value="16mil"/>
<param name="msDrill" value="32mil"/>
<param name="msMicroVia" value="9.99mm"/>
