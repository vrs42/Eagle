                                           //       (SetupPkt.Recipient == RCPT_EP)&&                                       C:\Projects\UBW\FW\2455\B\system\usb\usb9\usb9.c
                                           //       (SetupPkt.EPNum != 0))                                                  C:\Projects\UBW\FW\2455\B\system\usb\usb9\usb9.c
                                           //    {                                                                          C:\Projects\UBW\FW\2455\B\system\usb\usb9\usb9.c
                                           //        ctrl_trf_session_owner = MUID_USB9;                                    C:\Projects\UBW\FW\2455\B\system\usb\usb9\usb9.c
                                           //        /* Must do address calculation here */                                 C:\Projects\UBW\FW\2455\B\system\usb\usb9\usb9.c
                                           //        pDst.bRam = (byte*)&ep0Bo+(SetupPkt.EPNum*8)+(SetupPkt.EPDir*4);       C:\Projects\UBW\FW\2455\B\system\usb\usb9\usb9.c
                                           //                                                                               C:\Projects\UBW\FW\2455\B\system\usb\usb9\usb9.c
