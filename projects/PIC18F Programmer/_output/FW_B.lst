                                           //        if(SetupPkt.bRequest == SET_FEATURE)                                   C:\Projects\UBW\FW\2455\B\system\usb\usb9\usb9.c
                                           //            usb_stat.RemoteWakeup = 1;                                         C:\Projects\UBW\FW\2455\B\system\usb\usb9\usb9.c
                                           //        else                                                                   C:\Projects\UBW\FW\2455\B\system\usb\usb9\usb9.c
                                           //            usb_stat.RemoteWakeup = 0;                                         C:\Projects\UBW\FW\2455\B\system\usb\usb9\usb9.c
                                           //    }//end if                                                                  C:\Projects\UBW\FW\2455\B\system\usb\usb9\usb9.c
