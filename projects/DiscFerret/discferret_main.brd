<designrules name="default *">
<description language="en">&lt;b&gt;PCB-Pool Multilayer Design Rules&lt;/b&gt;
&lt;p&gt;
Design Rules as specified by PCB-Pool (www.pcb-pool.com) for PCB with 2 or 4 layers.
&lt;p&gt;
&lt;table border=0 cellpadding=0 cellspacing=0&gt;
&lt;tr&gt;&lt;td bgcolor=&quot;#CCCCCC&quot;&gt;Minimum Wire Width&lt;/td&gt;&lt;td bgcolor=&quot;#CCCCCC&quot;&gt;0.15mm (6mil)&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;Minimum Wire-to-Wire Clearance&lt;/td&gt;&lt;td&gt;0.15mm (6mil)&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td bgcolor=&quot;#CCCCCC&quot;&gt;Minimum Drill&lt;/td&gt;&lt;td bgcolor=&quot;#CCCCCC&quot;&gt;0.3mm (12mil)&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;Pad/Via Restring ((pad dia - drill dia) / 2)&lt;/td&gt;&lt;td&gt;0.2mm (8mil)&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td bgcolor=&quot;#CCCCCC&quot;&gt;Solder Stop Vanish Clearance&lt;/td&gt;&lt;td bgcolor=&quot;#CCCCCC&quot;&gt;0.15m (6mil)&lt;/td&gt;&lt;/tr&gt;
&lt;/table&gt;</description>
<param name="layerSetup" value="(1*16)"/>
<param name="mtCopper" value="0.035mm 0.035mm 0.035mm 0.035mm 0.035mm 0.035mm 0.035mm 0.035mm 0.035mm 0.035mm 0.035mm 0.035mm 0.035mm 0.035mm 0.035mm 0.035mm"/>
<param name="mtIsolate" value="1.5mm 0.15mm 0.2mm 0.15mm 0.2mm 0.15mm 0.2mm 0.15mm 0.2mm 0.15mm 0.2mm 0.15mm 0.2mm 0.15mm 0.2mm"/>
