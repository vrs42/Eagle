<text x="6.35" y="19.05" size="1.778" layer="21">#define SIX 1+5</text>
<text x="6.35" y="16.51" size="1.778" layer="21">#define NINE 8+1</text>
<text x="6.35" y="13.97" size="1.778" layer="21">uart_send(SIX * NINE == 42 ? "6*9=42" :</text>
<text x="19.05" y="11.43" size="1.778" layer="21">"this sentence is FALSE.");</text>
